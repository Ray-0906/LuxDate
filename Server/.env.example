# LuxDate Server — copy to `.env` and adjust.
# See `src/config/env.js` for all variables.

# --- Payments (Razorpay vs mock) ---
# `PAYMENT_MOCK=true` forces mock gateway for new orders (no real money).
# In development, mock also auto-enables when `RAZORPAY_KEY_ID` is unset/blank,
# unless you set `PAYMENT_MOCK=false` explicitly.
PAYMENT_MOCK=true
PAYMENT_MOCK_ALLOW_PROD=false

RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Never set PAYMENT_MOCK_ALLOW_PROD=true in real production unless intentional.
